# Application
APP_NAME="Pulse Ledger"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173

# MySQL (Docker Compose defaults)
MYSQL_DATABASE=expense_tracker
MYSQL_USER=expense_app
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
DATABASE_URL=mysql+pymysql://expense_app:change-me-local@localhost:3306/expense_tracker

# Authentication - replace with a long random value outside local development
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RECURRING_PROCESSOR_INTERVAL_MINUTES=15
